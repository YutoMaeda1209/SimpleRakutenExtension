{
  "manifest_version": 3,
  "name": "Simple Rakuten",
  "version": "1.0.0",
  "description": "楽天市場の商品ページで画像をスライドショーにまとめ、カートボタンまでのスクロールを減らします。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://item.rakuten.co.jp/*/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
